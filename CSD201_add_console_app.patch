+package warehouse.app;
+
+import warehouse.model.Batch;
+import warehouse.model.Product;
+import warehouse.service.Inventory;
+import warehouse.structure.BSTNode;
+
+import java.io.IOException;
+import java.io.PrintStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.NoSuchElementException;
+import java.util.Scanner;
+
+/**
+ * Chương trình quản lý kho dạng menu dòng lệnh, gọi các nghiệp vụ của Inventory (Mục V.A).
+ * Chạy: java -cp out warehouse.app.WarehouseApp [thư_mục_dữ_liệu]   (mặc định: ./data)
+ */
+public class WarehouseApp {
+    private static final DateTimeFormatter DMY = DateTimeFormatter.ofPattern("dd/MM/yyyy");
+
+    private final Inventory inv = new Inventory();
+    private final Scanner in;
+    private final PrintStream out;
+    private final CsvStore store;
+
+    public WarehouseApp(Scanner in, PrintStream out, Path dataDir) {
+        this.in = in;
+        this.out = out;
+        this.store = new CsvStore(dataDir);
+    }
+
+    public static void main(String[] args) throws Exception {
+        Path dir = Paths.get(args.length > 0 ? args[0] : "data");
+        PrintStream out = new PrintStream(System.out, true, StandardCharsets.UTF_8);
+        new WarehouseApp(new Scanner(System.in, StandardCharsets.UTF_8), out, dir).run();
+    }
+
+    // ------------------------------------------------------------------ vòng lặp chính
+    public void run() {
+        out.println("=== HỆ THỐNG QUẢN LÝ KHO (BST + Queue FIFO) ===");
+        try {
+            List<String> warnings = store.load(inv);
+            for (String w : warnings) out.println("Cảnh báo khi nạp dữ liệu: " + w);
+            out.println("Đã nạp " + inv.getProductBST().inOrderTraversal().size() + " sản phẩm.");
+        } catch (IOException e) {
+            out.println("Không đọc được dữ liệu: " + e.getMessage() + " (bắt đầu với kho rỗng)");
+        }
+        try {
+            while (true) {
+                printMenu();
+                String choice = ask("Chọn chức năng");
+                switch (choice) {
+                    case "1": addProduct(); break;
+                    case "2": lookupProduct(); break;
+                    case "3": deleteProduct(); break;
+                    case "4": receiveBatch(); break;
+                    case "5": issueStock(); break;
+                    case "6": checkExpiry(); break;
+                    case "7": report(); break;
+                    case "8": save(); break;
+                    case "0": save(); out.println("Tạm biệt!"); return;
+                    default: out.println("Lựa chọn không hợp lệ.");
+                }
+            }
+        } catch (NoSuchElementException e) {      // hết đầu vào (Ctrl+D / Ctrl+Z): lưu rồi thoát
+            out.println();
+            save();
+        }
+    }
+
+    private void printMenu() {
+        out.println();
+        out.println("----------------- MENU -----------------");
+        out.println(" 1. Thêm sản phẩm");
+        out.println(" 2. Tra cứu sản phẩm theo barcode");
+        out.println(" 3. Xóa sản phẩm (chỉ khi không còn lô)");
+        out.println(" 4. Nhập lô hàng");
+        out.println(" 5. Xuất kho (FIFO, bỏ qua lô hết hạn)");
+        out.println(" 6. Cảnh báo lô hết hạn / sắp hết hạn");
+        out.println(" 7. Báo cáo tồn kho");
+        out.println(" 8. Lưu dữ liệu");
+        out.println(" 0. Lưu và thoát");
+    }
+
+    // ------------------------------------------------------------------ các chức năng
+    private void addProduct() {
+        String barcode = ask("Barcode");
+        if (barcode.isEmpty()) { out.println("Barcode không được để trống."); return; }
+        String name = ask("Tên sản phẩm");
+        String unit = ask("Đơn vị tính");
+        Integer min = askInt("Tồn tối thiểu (minStock)");
+        if (min == null) return;
+        boolean ok = inv.getProductBST().insert(new Product(barcode, name, unit, min));
+        out.println(ok ? "Đã thêm sản phẩm " + barcode + "." : "Barcode đã tồn tại, không thêm.");
+    }
+
+    private void lookupProduct() {
+        BSTNode node = inv.getProductBST().search(ask("Barcode"));
+        if (node == null) { out.println("Không tìm thấy sản phẩm."); return; }
+        Product p = node.getProduct();
+        out.println("Sản phẩm: " + p.getBarcode() + " | " + p.getName() + " | đơn vị " + p.getUnit()
+                + " | tồn tối thiểu " + p.getMinStock());
+        List<Batch> batches = node.getBatchQueue().toList();
+        if (batches.isEmpty()) { out.println("  (chưa có lô nào)"); return; }
+        out.println("  Các lô theo thứ tự xuất (đầu hàng đợi trước):");
+        for (Batch b : batches)
+            out.println("  - " + b.getBatchId() + ": SL " + b.getQuantity() + ", nhập " + fmt(b.getImportDate())
+                    + ", HSD " + fmt(b.getExpiryDate()));
+    }
+
+    private void deleteProduct() {
+        String barcode = ask("Barcode cần xóa");
+        BSTNode node = inv.getProductBST().search(barcode);
+        if (node == null) { out.println("Không tìm thấy sản phẩm."); return; }
+        if (inv.getProductBST().delete(barcode)) out.println("Đã xóa sản phẩm " + barcode + ".");
+        else out.println("Không xóa được: sản phẩm còn " + node.getBatchQueue().size() + " lô trong kho.");
+    }
+
+    private void receiveBatch() {
+        String barcode = ask("Barcode sản phẩm");
+        if (inv.getProductBST().search(barcode) == null) { out.println("Sản phẩm chưa có trong danh mục."); return; }
+        String id = ask("Mã lô");
+        LocalDate imp = askDate("Ngày nhập", true);
+        if (imp == null) return;
+        LocalDate exp = askDate("Hạn sử dụng", false);
+        if (exp == null) return;
+        Integer qty = askInt("Số lượng");
+        if (qty == null) return;
+        boolean ok = inv.receiveBatch(barcode, new Batch(id, imp, exp, qty));
+        out.println(ok ? "Đã nhập lô " + id + " vào cuối hàng đợi."
+                : "Nhập thất bại: số lượng phải > 0 và hạn sử dụng phải sau ngày nhập.");
+    }
+
+    private void issueStock() {
+        String barcode = ask("Barcode sản phẩm");
+        if (inv.getProductBST().search(barcode) == null) { out.println("Sản phẩm chưa có trong danh mục."); return; }
+        Integer qty = askInt("Số lượng cần xuất");
+        if (qty == null) return;
+        LocalDate today = askDate("Ngày xuất (Enter = hôm nay)", true);
+        if (today == null) return;
+        List<String> issued = new ArrayList<>(), expired = new ArrayList<>();
+        if (inv.issueStock(barcode, qty, today, issued, expired)) {
+            out.println("Xuất kho thành công. Lấy từ các lô (lô:số lượng): " + issued);
+            if (!expired.isEmpty()) out.println("Lô hết hạn đã bị loại khỏi hàng đợi: " + expired);
+        } else {
+            out.println("Từ chối: số lượng không hợp lệ hoặc tồn còn hạn không đủ. Kho không thay đổi.");
+        }
+    }
+
+    private void checkExpiry() {
+        LocalDate today = askDate("Ngày kiểm tra (Enter = hôm nay)", true);
+        if (today == null) return;
+        Integer k = askInt("Số ngày cảnh báo trước (K)");
+        if (k == null) return;
+        List<String> list = inv.checkExpiry(today, k);
+        if (list.isEmpty()) { out.println("Không có lô nào hết hạn hoặc sắp hết hạn."); return; }
+        out.println("barcode | lô | số lượng | trạng thái");
+        for (String s : list) out.println("  " + s.replace("|", " | "));
+    }
+
+    private void report() {
+        List<String> rows = inv.generateInventoryReport();
+        if (rows.isEmpty()) { out.println("Kho chưa có sản phẩm."); return; }
+        out.println("barcode | tên | đơn vị | tồn tối thiểu | tổng SL | số lô | HSD sớm nhất");
+        for (String r : rows) out.println("  " + r.replace("|", " | "));
+    }
+
+    private void save() {
+        try { store.save(inv); out.println("Đã lưu dữ liệu."); }
+        catch (IOException e) { out.println("Lỗi khi lưu: " + e.getMessage()); }
+    }
+
+    // ------------------------------------------------------------------ nhập liệu
+    private String ask(String label) {
+        out.print(label + ": ");
+        out.flush();
+        return in.nextLine().trim();           // ném NoSuchElementException khi hết đầu vào
+    }
+
+    private Integer askInt(String label) {
+        String s = ask(label);
+        try { return Integer.parseInt(s); }
+        catch (NumberFormatException e) { out.println("Giá trị phải là số nguyên."); return null; }
+    }
+
+    /** Nhận dd/MM/yyyy hoặc yyyy-MM-dd. allowToday: để trống = hôm nay. */
+    private LocalDate askDate(String label, boolean allowToday) {
+        String s = ask(label + " [dd/MM/yyyy]");
+        if (s.isEmpty() && allowToday) return LocalDate.now();
+        try { return s.contains("/") ? LocalDate.parse(s, DMY) : LocalDate.parse(s); }
+        catch (DateTimeParseException e) { out.println("Ngày không hợp lệ."); return null; }
+    }
+
+    private static String fmt(LocalDate d) { return d.format(DMY); }
+}
