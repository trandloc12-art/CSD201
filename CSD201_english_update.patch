-sh build.sh                              # hoặc: javac -encoding UTF-8 -d out $(find src -name '*.java')
-java -cp out warehouse.MainTest          # 57 PASS, 0 FAIL
-java -Xms1g -Xmx2g -cp out warehouse.Benchmark > bench.csv   # 5-8 phút
-```
